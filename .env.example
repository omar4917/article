# ── Application ────────────────────────────────────────────────────
APP_NAME="The Pitch Report"
APP_VERSION="1.0.0"
DEBUG=true

# ── Security ───────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./pitch_report.db

# ── Admin defaults ─────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@pitchreport.com
DEFAULT_ADMIN_PASSWORD=admin
